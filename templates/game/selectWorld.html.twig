{% extends 'noBarBase.html.twig' %}

{% block title %}Ultimate Warfare - Select World{% endblock title %}

{% block content %}
    <div class="uw-card">
        <div class="uw-card-header">Select your World</div>
        <div class="uw-card-body">
            {% for world in worlds %}
                <div style="display: flex; gap: 30px; align-items: flex-start; padding: 15px 0; border-bottom: 1px solid #3a3a3a;">
                    <div>
                        <strong>{{ world.name }}</strong><br />
                        <img src="{{ path('Game/World/Image', {'worldId': world.id}) }}" alt="{{ world.name }}" style="margin-top: 10px;">
                    </div>
                    <div>
                        <strong>Max players:</strong> {{ world.maxplayers }}<br /><br />
                        <strong>Info:</strong><br />
                        {{ world.description }}<br /><br />
                        <strong>At start:</strong><br />
                        Cash: {{ world.resources.cash }}<br />
                        Wood: {{ world.resources.wood }}<br />
                        Steel: {{ world.resources.steel }}<br />
                        Food: {{ world.resources.food }}<br /><br />
                        <a class="btn btn-primary" href="{{ path('Game/SelectName', {'worldId': world.id}) }}"><strong>Play this World</strong></a>
                    </div>
                </div>
            {% else %}
                <div class="text-center">
                    <p>No active worlds to join. Create a new game world!</p>
                    <a class="btn btn-primary" href="{{ path('Game/World/Create') }}"><strong>Create new world</strong></a>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}
