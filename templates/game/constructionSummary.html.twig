{% extends 'game.html.twig' %}

{% block title %}Ultimate Warfare - Construction summary{% endblock title %}

{% block content %}
    <p class="text-center">
        <a class="B" href="{{ path('Game/Construction') }}">Summary</a>
        {% for gameUnitCategory in gameUnitCategories %}
            - <a class="B" href="{{ path('Game/Construction', {'gameUnitCategoryId': gameUnitCategory.value}) }}">{{ gameUnitCategory.label }}</a>
        {% endfor %}
    </p>

    <table class="table text-center">
        <tr class="tabletop">
            <td colspan="2"><b>Construction summary</b></td>
        </tr>
        {% for gameUnitCategory in gameUnitCategories %}
            <tr class="tabletop">
                <td colspan="2"><b>{{ gameUnitCategory.label }}</b></td>
            </tr>

            {% set gameUnitInConstruction = 0 %}
            {% for gameUnit in gameUnits %}
                {% if gameUnit.gameUnitCategory == gameUnitCategory and constructionData[gameUnit.id.value] is defined and constructionData[gameUnit.id.value] > 0 %}
                    {% set gameUnitInConstruction = 1 %}
                    <tr>
                        <td width="350">{{ gameUnit.nameMulti }}:</td>
                        <td width="350">
                            {{ constructionData[gameUnit.id.value] }}
                        </td>
                    </tr>
                {% endif %}
            {% endfor %}

            {% if gameUnitInConstruction == 0 %}
                <tr>
                    <td colspan="2">You don't have any {{ gameUnitCategory.label }} in construction</td>
                </tr>
            {% endif %}
        {% endfor %}
    </table>
{% endblock %}
