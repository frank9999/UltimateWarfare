{% extends 'noBarBase.html.twig' %}

{% block title %}Ultimate Warfare - Pick your name{% endblock title %}

{% block content %}
    <form action="{{ path('Game/StartWorld', {'worldId': world.id}) }}" method="POST">
        <div class="form-card-wrapper">
            <div class="uw-card">
                <div class="uw-card-header">Select your Name</div>
                <div class="uw-card-body">
                    <div class="mb-3">
                        <label for="name" class="form-label">Name</label>
                        <input type="text" class="form-control" id="name" name="name"/>
                    </div>
                    <button class="btn btn-primary w-100" type="submit">Play</button>
                </div>
            </div>
        </div>

        <div class="uw-card" style="margin-top: 20px;">
            <div class="uw-card-body">
                <div style="display: flex; gap: 30px; align-items: flex-start;">
                    <div>
                        <strong>{{ world.name }}</strong><br />
                        <img src="{{ asset('images/world/' ~ world.image) }}" alt="{{ world.name }}" style="margin-top: 10px;">
                    </div>
                    <div>
                        <strong>Max players:</strong> {{ world.maxplayers }}<br /><br />
                        <strong>Info:</strong><br />
                        {{ world.description }}<br /><br />
                        <strong>At start:</strong><br />
                        Cash: {{ world.resources.cash }}<br />
                        Wood: {{ world.resources.wood }}<br />
                        Steel: {{ world.resources.steel }}<br />
                        Food: {{ world.resources.food }}
                    </div>
                </div>
            </div>
        </div>
    </form>
{% endblock %}
