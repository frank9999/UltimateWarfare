{% extends 'game.html.twig' %}

{% block title %}Ultimate Warfare - Federation bank withdraw{% endblock title %}

{% block content %}
    {{ form_start(form) }}
        <table class="table text-center">
            <tr class="tabletop">
                <td colspan="4"><b>Federation bank Withdraw</b></td>
            </tr>
            <tr>
                <td>Resources</td>
                <td>You</td>
                <td>Bank</td>
                <td>Amount</td>
            </tr>
            <tr>
                <td>Cash:</td>
                <td>$ {{ player.resources.cash }}</td>
                <td>$ {{ federationResources.cash }}</td>
                <td>{{ form_widget(form.cash) }}</td>
            </tr>
            <tr>
                <td>Wood:</td>
                <td>{{ player.resources.wood }}</td>
                <td>{{ federationResources.wood }}</td>
                <td>{{ form_widget(form.wood) }}</td>
            </tr>
            <tr>
                <td>Steel:</td>
                <td>{{ player.resources.steel }}</td>
                <td>{{ federationResources.steel }}</td>
                <td>{{ form_widget(form.steel) }}</td>
            </tr>
            <tr>
                <td>Food:</td>
                <td>{{ player.resources.food }}</td>
                <td>{{ federationResources.food }}</td>
                <td>{{ form_widget(form.food) }}</td>
            </tr>
            <tr>
                <td colspan="4">
                    {{ form_widget(form.submit) }}
                </td>
            </tr>
        </table>
    {{ form_end(form) }}
{% endblock %}
