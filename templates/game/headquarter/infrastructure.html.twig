{% extends 'game.html.twig' %}
{% block content %}
    <p class="text-center">
        Advanced stats: <a class="B" href="{{ path('Game/Headquarter/Income') }}">Income</a> - <a class="B" href="{{ path('Game/Headquarter/Army') }}">Army</a> - <a class="B" href="{{ path('Game/Headquarter/Infrastructure') }}">Infrastructure</a>
    </p>

    <table class="table text-center">
        <tr class="tabletop">
            <td colspan="4"><b>Infrastructure</b></td>
        </tr>
        {% for gameUnitCategory in gameUnitCategories %}
            <tr>
                <td colspan="2" class="tabletop"><b>{{ gameUnitCategory.label }}</b></td>
            </tr>

            {% set gameUnitCategoryExist = 0 %}
            {% for gameUnit in gameUnits %}
                {% if gameUnit.gameUnitCategory == gameUnitCategory and gameUnitData[gameUnit.id.value] is defined and gameUnitData[gameUnit.id.value] > 0 %}
                    {% set gameUnitCategoryExist = 1 %}
                    <tr>
                        <td width="350">{{ gameUnit.nameMulti }}:</td>
                        <td width="350">
                            {{ gameUnitData[gameUnit.id.value] }}
                        </td>
                    </tr>
                {% endif %}
            {% endfor %}

            {% if gameUnitCategoryExist == 0 %}
                <tr>
                    <td colspan="2">You don't have any {{ gameUnitCategory.label }}</td>
                </tr>
            {% endif %}
        {% endfor %}
    </table>
{% endblock %}
