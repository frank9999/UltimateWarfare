{% extends 'admin.html.twig' %}

{% block title %}ADMIN - Game news{% endblock title %}

{% block content %}
    <p class="text-right">
        <a class="btn btn-primary" href="{{ path('Admin/GameNews/Create') }}"><b>Create game news</b></a>
    </p>

    <div class="uw-card">
        <div class="uw-card-header">Game news</div>
        <div class="uw-card-body">
            <table class="table text-center">
                {% for news in gameNews %}
                    <tr>
                        <td>
                            {{ news.title }}
                        </td>
                        <td>
                            {{ news.enabled }}
                        </td>
                        <td>
                            {{ news.mainpage }}
                        </td>
                        <td>
                            {{ news.createDateTime|date("Y-m-d H:i:s") }}
                        </td>
                        <td>
                            <a class="btn btn-primary" href="{{ path('Admin/GameNews/Edit', {'gameNewsId': news.id}) }}">Edit</a>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="5">
                            {{ news.message|nl2br }}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5">No game news....</td>
                    </tr>
                {% endfor %}
            </table>
        </div>
    </div>
{% endblock %}
