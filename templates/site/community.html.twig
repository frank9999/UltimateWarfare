{% extends 'site.html.twig' %}

{% block title %}Ultimate Warfare - Community{% endblock title %}

{% block content %}
    <div class="uw-card">
        <div class="uw-card-header">Community</div>
        <div class="uw-card-body text-center">
            <p>
                Ultimate Warfare is a free and open-source online multiplayer browser based strategy game.
            </p>
            <p>
                <a class="btn btn-primary" href="https://github.com/FrankProjects/UltimateWarfare">Check it out on GitHub</a>
            </p>

            <h3>Support Ultimate Warfare</h3>
            <p>
                Ultimate-Warfare is and will always be free to play, but far from free to develop, run and maintain. Please consider supporting us with a donation.
            </p>
            <p>
                Donations are currently accepted through Paypal.
            </p>
            <p>
                <a href="https://www.paypal.me/frankschreuder"><img src="{{ asset('images/donate.gif') }}" alt="Donate" /></a>
            </p>
        </div>
    </div>
{% endblock %}
