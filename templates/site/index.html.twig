{% extends 'site.html.twig' %}
{% block content %}
    <div class="uw-hero" style="background-image: url('{{ asset('images/uw_background.jpg') }}');">
        <div class="uw-hero-overlay">
            <h1>Ultimate Warfare</h1>
            <p class="tagline">Compete for world domination in this free multiplayer strategy game</p>
            <a class="btn-cta" href="{{ path('Site/Register') }}">Play Now - Free</a>
        </div>
    </div>

    <div class="features-grid">
        <div class="feature-item">
            <strong>Free to Play</strong>
            <span>Browser based MMORPG, no download required</span>
        </div>
        <div class="feature-item">
            <strong>PVP Battles</strong>
            <span>Player vs Player and Federation warfare</span>
        </div>
        <div class="feature-item">
            <strong>World Map</strong>
            <span>Conquer regions on an interactive hex map</span>
        </div>
        <div class="feature-item">
            <strong>Strategy</strong>
            <span>Research, build, and command your armies</span>
        </div>
    </div>

    <div class="uw-card">
        <div class="uw-card-header">Game News</div>
        <div class="uw-card-body">
            {% for news in gameNews %}
                <div class="news-item">
                    <div class="news-title">{{ news.title }}</div>
                    <div>{{ news.message|nl2br }}</div>
                    <div class="news-date">Posted on {{ news.createDateTime|date("Y-m-d H:i:s") }}</div>
                </div>
            {% else %}
                <p class="text-center">No game news yet.</p>
            {% endfor %}
        </div>
    </div>
{% endblock %}
