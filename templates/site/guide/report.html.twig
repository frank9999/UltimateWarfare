{% extends 'site/guideBase.html.twig' %}
{% block content %}
    <div class="uw-card">
        <div class="uw-card-header">Reports</div>
        <div class="uw-card-body">
            <table class="table text-center">
                <tr>
                    <td width="150"><b>Date</b></td>
                    <td class="text-start" width="550"><b>Report</b></td>
                </tr>
                <tr>
                    <td>2026-03-30 14:16:12</td>
                    <td class="text-start">You completed 200 Tank(s) at region (16, 17)</td>
                </tr>
                <tr>
                    <td>2026-03-30 13:11:21</td>
                    <td class="text-start">You completed 55 Soldier(s) at region (8, 12)</td>
                </tr>
                <tr>
                    <td>2026-03-30 12:27:12</td>
                    <td class="text-start">You have researched Advanced Weaponry.</td>
                </tr>
            </table>
        </div>
    </div>

    <br/>

    <div class="uw-card">
        <div class="uw-card-body">
            <p>
                This is your report page. Reports track important in-game events such as:
            </p>
            <ul>
                <li>
                    <b>Date:</b> The time when the event occurred.
                </li>
                <li>
                    <b>Report:</b> The event details. Reports can include construction completions, research completions,
                    battle results, market transactions, and more.
                </li>
            </ul>
        </div>
    </div>
{% endblock %}
