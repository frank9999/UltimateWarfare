{% extends 'site/guideBase.html.twig' %}

{% block content %}
    <div class="uw-card">
        <div class="uw-card-header">Research</div>
        <div class="uw-card-body">
            <table class="table text-center">
                {% for research in researches %}
                    <tr>
                        <td width="150"><img src="{{ asset('images/research/' ~ research.image) }}" alt="{{ research.name }}" width="150" height="130"></td>

                        <td class="text-start" width="450">
                            {{ research.description }}<br /><br />
                            Name: {{ research.name }}<br />
                            Max level: {{ research.maxLevel }}<br /><br />

                            {% for level in 1..research.maxLevel %}
                                <b>Level {{ level }}:</b> Cost ${{ research.getCost(level) }}, Time {{ research.getTimestamp(level) }}s
                                {% set prereqs = research.getPrerequisiteDescriptions(level) %}
                                {% if prereqs|length > 0 %}
                                    &mdash; Requires:
                                    {% for prereq in prereqs %}
                                        {{ prereq.name }} lvl {{ prereq.minLevel }}{% if not loop.last %}, {% endif %}
                                    {% endfor %}
                                {% endif %}
                                <br />
                            {% endfor %}
                        </td>
                {% endfor %}
            </table>
        </div>
    </div>
{% endblock %}
