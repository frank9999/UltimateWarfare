{% extends 'site/guideBase.html.twig' %}

{% block content %}
    <div class="uw-card">
        <div class="uw-card-header">Select Unit Type</div>
        <div class="uw-card-body">
                {% for gameUnitCategory in gameUnitCategories %}
                    <a href="{{ path('Guide/ListUnits', {'gameUnitCategoryId': gameUnitCategory.value}) }}">{{ gameUnitCategory.label }}</a><br />
                {% endfor %}
        </div>
    </div>
{% endblock %}
