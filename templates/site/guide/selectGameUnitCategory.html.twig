{% extends 'site/guideBase.html.twig' %}

{% block content %}
    <table class="table text-center">
        <tr class="tabletop">
            <td><b>Select Unit Type</b></td>
        </tr>
        <tr>
            <td>
                {% for gameUnitCategory in gameUnitCategories %}
                    <a href="{{ path('Guide/ListUnits', {'gameUnitCategoryId': gameUnitCategory.value}) }}" class="B">{{ gameUnitCategory.label }}</a><br />
                {% endfor %}
            </td>
        </tr>
    </table>
{% endblock %}
