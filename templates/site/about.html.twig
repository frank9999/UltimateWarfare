{% extends 'site.html.twig' %}
{% trans_default_domain 'site' %}

{% block title %}{{ 'about.title'|trans }}{% endblock title %}

{% block content %}
    <div class="uw-card">
        <div class="uw-card-header">{{ 'about.header'|trans }}</div>
        <div class="uw-card-body">
            <p>{{ 'about.intro'|trans }}</p>

            <h3>{{ 'about.game.heading'|trans }}</h3>
            <ul>
                {% for item in ['long_game', 'economy', 'military', 'diplomacy'] %}
                    <li><b>{{ ('about.game.' ~ item ~ '.title')|trans }}</b> {{ ('about.game.' ~ item ~ '.text')|trans }}</li>
                {% endfor %}
            </ul>
            <p>
                {{ 'about.game.guide'|trans({'%linkStart%': '<a href="' ~ path('Guide') ~ '">', '%linkEnd%': '</a>'})|raw }}
            </p>

            <h3>{{ 'about.support.heading'|trans }}</h3>
            <p>
                {{ 'about.support.paragraph_1'|trans({'%linkStart%': '<a href="https://frankprojects.com">', '%linkEnd%': '</a>'})|raw }}
            </p>
            <p>
                {{ 'about.support.paragraph_2'|trans({'%linkStart%': '<a href="https://github.com/FrankProjects/UltimateWarfare">', '%linkEnd%': '</a>'})|raw }}
            </p>
            <p>{{ 'about.support.paragraph_3'|trans }}</p>
            <p>
                <a href="https://www.paypal.me/frankschreuder"><img src="{{ asset('images/donate.gif') }}" alt="{{ 'about.support.donate_alt'|trans }}" /></a>
            </p>
        </div>
    </div>
{% endblock %}
