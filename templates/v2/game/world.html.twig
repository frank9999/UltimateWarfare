{% extends 'v2/game.html.twig' %}

{% block title %}Ultimate Warfare - World Map{% endblock title %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        #worldMapContainer {
            width: 100%;
            margin: 20px auto;
            border: 2px solid #8B7355;
            border-radius: 8px;
            background: #2a2a2a;
        }

        #worldMap {
            display: block;
            background: #1a1a1a;
        }

        .map-controls {
            padding: 15px;
            background: #3a3a3a;
            border-bottom: 2px solid #8B7355;
        }

        .map-controls form {
            display: inline-block;
            margin-right: 20px;
        }

        .map-controls input[type="text"] {
            padding: 5px 10px;
            border: 1px solid #8B7355;
            background: #2a2a2a;
            color: #f3e6c1;
            border-radius: 4px;
        }

        .map-controls button {
            padding: 5px 15px;
            background: #8B7355;
            color: #f3e6c1;
            border: none;
            border-radius: 4px;
            cursor: pointer;
        }

        .map-controls button:hover {
            background: #a08365;
        }

        .map-legend {
            padding: 10px;
            background: #3a3a3a;
            border-top: 2px solid #8B7355;
            display: flex;
            gap: 15px;
            font-size: 12px;
        }

        .legend-item {
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .legend-color {
            width: 20px;
            height: 20px;
            border: 1px solid #8B7355;
        }
    </style>
{% endblock stylesheets %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/isometric-map.js') }}"></script>
{% endblock javascripts %}

{% block content %}
    <div class="row">
        <div class="col-md-12">
            <div id="worldMapContainer">
                <div class="map-controls">
                    <form action="{{ path('Game/World/Search/Free') }}" method="get">
                        <button type="submit">Show Free Regions</button>
                    </form>

                    <form action="{{ path('Game/World/Search/Player') }}" method="post">
                        <input type="text" name="playerName" placeholder="Search player..."
                               value="{% if mapSettings is defined and mapSettings.searchPlayerName is defined %}{{ playerName|default('') }}{% endif %}" />
                        <button type="submit">Search</button>
                    </form>

                    <form action="{{ path('Game/World') }}" method="get" style="float: right;">
                        <button type="submit">Reset View</button>
                    </form>
                </div>

                <canvas id="worldMap"></canvas>

                <div class="map-legend">
                    <div class="legend-item">
                        <div class="legend-color" style="background: rgba(74, 124, 89, 0.5);"></div>
                        <span>Free Region</span>
                    </div>
                    <div class="legend-item">
                        <div class="legend-color" style="background: rgba(124, 74, 74, 0.5);"></div>
                        <span>Enemy Region</span>
                    </div>
                    <div class="legend-item">
                        <div class="legend-color" style="background: rgba(74, 90, 124, 0.5);"></div>
                        <span>Your Region</span>
                    </div>
                </div>
            </div>

            {% if mapSettings is defined and mapSettings.searchPlayerName is defined and not mapSettings.searchFound %}
                <div class="alert alert-warning" style="margin-top: 20px;">
                    Player "{{ playerName }}" not found in this world.
                </div>
            {% endif %}

            {% if mapSettings is defined and mapSettings.searchFree %}
                <div class="alert alert-info" style="margin-top: 20px;">
                    Showing only free regions. Total: {{ regions|length }}
                </div>
            {% endif %}
        </div>
    </div>

    <script>
        // Build region URL pattern (generated by Twig, used by JavaScript)
        const regionUrlPattern = '/game/world/region/';

        // Prepare WorldRegion data for the isometric map
        const worldRegions = [
            {% for region in regions %}
            {
                x: {{ region.x }},
                y: {{ region.y }},
                id: {{ region.id }},
                name: {{ region.name|json_encode|raw }},
                type: {{ region.type|json_encode|raw }},
                image: {{ region.image|json_encode|raw }},
                hasOwner: {{ region.hasOwner ? 'true' : 'false' }},
                isYours: {{ region.isYours ? 'true' : 'false' }},
                ownerName: {{ region.ownerName|json_encode|raw }}
            }{% if not loop.last %},{% endif %}
            {% endfor %}
        ];

        console.log('Loading ' + worldRegions.length + ' world regions...');

        // Initialize the isometric map
        const worldMap = new IsometricMap('worldMap', {
            tileWidth: 128,
            tileHeight: 64,
            imageBasePath: '{{ asset('images') }}',
            onTileClick: function(region) {
                // Navigate to region page when clicked
                window.location.href = regionUrlPattern + region.id;
            }
        });

        // Custom rendering for WorldRegions with ownership overlay
        worldMap.renderTile = function(region) {
            const iso = this.cartesianToIsometric(region.x, region.y);

            // Get the base terrain image from the region
            const imageUrl = `${this.config.imageBasePath}/map/${region.image}`;
            const img = this.images.get(imageUrl);

            if (img) {
                // Draw the base terrain tile
                this.ctx.drawImage(
                    img,
                    iso.x - this.config.tileWidth / 2,
                    iso.y - this.config.tileHeight / 2,
                    this.config.tileWidth,
                    this.config.tileHeight
                );

                // Add ownership overlay
                this.ctx.save();
                if (region.hasOwner) {
                    if (region.isYours) {
                        // Blue tint for your regions
                        this.ctx.fillStyle = 'rgba(74, 90, 124, 0.5)';
                    } else {
                        // Red tint for enemy regions
                        this.ctx.fillStyle = 'rgba(124, 74, 74, 0.5)';
                    }
                } else {
                    // Slight green tint for free regions
                    this.ctx.fillStyle = 'rgba(74, 124, 89, 0.3)';
                }

                // Draw ownership overlay
                this.ctx.fillRect(
                    iso.x - this.config.tileWidth / 2,
                    iso.y - this.config.tileHeight / 2,
                    this.config.tileWidth,
                    this.config.tileHeight
                );
                this.ctx.restore();

                // Draw coordinates and owner name always visible
                this.ctx.save();
                this.ctx.fillStyle = '#ffffff';
                this.ctx.font = '9px Arial';
                this.ctx.textAlign = 'center';
                this.ctx.strokeStyle = '#000000';
                this.ctx.lineWidth = 2;

                // Coordinates
                const coordText = `${region.x},${region.y}`;
                this.ctx.strokeText(coordText, iso.x, iso.y - 2);
                this.ctx.fillText(coordText, iso.x, iso.y - 2);

                // Owner name if applicable
                if (region.hasOwner && region.ownerName) {
                    this.ctx.font = '8px Arial';
                    this.ctx.strokeText(region.ownerName, iso.x, iso.y + 8);
                    this.ctx.fillText(region.ownerName, iso.x, iso.y + 8);
                }

                this.ctx.restore();

                // Highlight hovered tile
                if (this.hoveredTile && this.hoveredTile.x === region.x && this.hoveredTile.y === region.y) {
                    this.ctx.strokeStyle = '#ffffff';
                    this.ctx.lineWidth = 2;
                    this.ctx.strokeRect(
                        iso.x - this.config.tileWidth / 2,
                        iso.y - this.config.tileHeight / 2,
                        this.config.tileWidth,
                        this.config.tileHeight
                    );

                    // Draw enhanced region info on hover
                    this.ctx.save();
                    this.ctx.fillStyle = '#ffffff';
                    this.ctx.font = 'bold 11px Arial';
                    this.ctx.textAlign = 'center';
                    this.ctx.strokeStyle = '#000000';
                    this.ctx.lineWidth = 3;

                    // Region name
                    this.ctx.strokeText(region.name, iso.x, iso.y - 15);
                    this.ctx.fillText(region.name, iso.x, iso.y - 15);

                    this.ctx.restore();
                }
            } else {
                // Fallback if image not loaded - draw colored rectangle
                this.ctx.fillStyle = region.hasOwner ? (region.isYours ? '#4a5a7c' : '#7c4a4a') : '#4a7c59';
                this.ctx.fillRect(
                    iso.x - this.config.tileWidth / 2,
                    iso.y - this.config.tileHeight / 2,
                    this.config.tileWidth,
                    this.config.tileHeight
                );
            }
        };

        // Load regions and render the map
        worldMap.setSectors(worldRegions).then(function() {
            worldMap.render();
            console.log('World map loaded successfully with ' + worldRegions.length + ' regions!');
        }).catch(function(error) {
            console.error('Failed to load world map:', error);
            alert('Failed to load world map. Please check the console for details.');
        });
    </script>
{% endblock content %}