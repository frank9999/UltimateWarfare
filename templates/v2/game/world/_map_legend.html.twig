<div class="map-legend">
    <div class="legend-item">
        <div class="legend-color" style="background: rgba(74, 124, 89, 0.5);"></div>
        <span>Free</span>
    </div>
    <div class="legend-item">
        <div class="legend-color" style="background: rgba(124, 74, 74, 0.5);"></div>
        <span>Enemy</span>
    </div>
    <div class="legend-item">
        <div class="legend-color" style="background: rgba(74, 90, 124, 0.5);"></div>
        <span>Yours</span>
    </div>
    <span style="color: #666;">|</span>
    <div class="legend-item">
        <div class="legend-color" style="background: #3d5a80; width: 12px; height: 12px; border-radius: 50%;"></div>
        <span>Buildings</span>
    </div>
    <div class="legend-item">
        <div class="legend-color" style="background: #7b6d8d; width: 12px; height: 12px; border-radius: 50%;"></div>
        <span>Defences</span>
    </div>
    <div class="legend-item">
        <div class="legend-color" style="background: #6b8e6b; width: 12px; height: 12px; border-radius: 50%;"></div>
        <span>Units</span>
    </div>
    <div class="legend-item">
        <div class="legend-color" style="background: #d4a03c; width: 12px; height: 12px; border-radius: 50%;"></div>
        <span>Special</span>
    </div>
    <div class="legend-item">
        <div class="legend-color" style="background: #c75146; width: 12px; height: 12px; border-radius: 50%;"></div>
        <span>Elite Units</span>
    </div>
    <button class="legend-toggle" id="toggleOverlay">Show Overlays</button>
</div>
