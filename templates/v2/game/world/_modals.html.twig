{# Attack Mode Banner #}
<div id="attackModeBanner" class="attack-mode-banner">
    <span id="attackModeText">Select a region to attack from...</span>
    <button type="button" id="cancelAttackModeBtn">Cancel</button>
</div>

{# Buy Region Modal #}
<div id="buyRegionModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <span class="modal-title">Buy World Region</span>
            <span class="close" id="closeModal">&times;</span>
        </div>
        <div class="modal-body" id="modalBody"></div>
        <div class="modal-footer">
            <button type="button" id="cancelBtn">Cancel</button>
            <button type="button" id="confirmBuyBtn">Buy Region</button>
        </div>
    </div>
</div>

{# Enemy Region Modal #}
<div id="enemyRegionModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <span class="modal-title">Enemy Region</span>
            <span class="close" id="closeEnemyModal">&times;</span>
        </div>
        <div class="modal-body" id="enemyModalBody"></div>
        <div class="modal-footer">
            <button type="button" id="sendMessageBtn">Send Message</button>
            <button type="button" id="attackBtn">Attack</button>
            <button type="button" id="operationBtn">Launch Operation</button>
        </div>
    </div>
</div>

{# Your Region Modal #}
<div id="yourRegionModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <span class="modal-title">Your Region</span>
            <span class="close" id="closeYourModal">&times;</span>
        </div>
        <div class="modal-body" id="yourModalBody"></div>
        <div class="modal-footer">
            <button type="button" id="buildBtn">Build</button>
            <button type="button" id="sendUnitsBtn">Move Units</button>
        </div>
    </div>
</div>

{# Headquarter Modal #}
<div id="headquarterModal" class="modal">
    <div class="modal-content modal-lg">
        <div class="modal-header">
            <span class="modal-title">Headquarter</span>
            <span class="close" id="closeHqModal">&times;</span>
        </div>
        <div class="modal-body">
            <p style="text-align: center;">Select an action:</p>
        </div>
        <div class="modal-footer hq-buttons">
            <button type="button" id="hqOldInterfaceBtn">Old Interface</button>
            <button type="button" id="hqMarketBtn">Market</button>
            <button type="button" id="hqFederationBtn">Federation</button>
            <button type="button" id="hqResearchBtn">Research</button>
            <button type="button" id="hqRegionsBtn">Regions</button>
            <button type="button" id="hqFleetsBtn">Fleets</button>
            <button type="button" id="hqConstructionBtn">Construction</button>
        </div>
    </div>
</div>

{# Build Modal #}
<div id="buildModal" class="modal">
    <div class="modal-content build-modal-content">
        <div class="modal-header">
            <span class="modal-title">Build Units - Region <span id="buildRegionCoords"></span></span>
            <span class="close" id="closeBuildModal">&times;</span>
        </div>
        <div class="modal-body">
            <div class="build-tabs" id="buildTabs"></div>
            <div id="buildSpaceInfo" class="build-space-info" style="display: none;"></div>
            <div id="buildUnitsContainer" class="build-units-container">
                <div class="build-loading">Loading units...</div>
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" id="closeBuildBtn">Cancel</button>
            <button type="button" id="confirmBuildBtn">Build Selected</button>
        </div>
    </div>
</div>

{# Reports Modal #}
<div id="reportsModal" class="modal">
    <div class="modal-content modal-lg">
        <div class="modal-header">
            <span class="modal-title">Reports</span>
            <span class="close" id="closeReportsModal">&times;</span>
        </div>
        <div class="modal-body">
            <div class="build-tabs" id="reportsTabs"></div>
            <div id="reportsContainer" style="max-height: 400px; overflow-y: auto;">
                <div class="build-loading">Loading reports...</div>
            </div>
            <div id="reportsPagination" style="margin-top: 15px; text-align: center; display: none;">
                <button type="button" id="reportsPrevBtn" class="legend-toggle" style="margin-right: 10px;">← Previous</button>
                <span id="reportsPageInfo" style="color: #f3e6c1;"></span>
                <button type="button" id="reportsNextBtn" class="legend-toggle" style="margin-left: 10px;">Next →</button>
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" id="closeReportsBtn">Close</button>
        </div>
    </div>
</div>

{# Select Operation Modal #}
<div id="selectOperationModal" class="modal">
    <div class="modal-content modal-lg">
        <div class="modal-header">
            <span class="modal-title">Select Operation — Target <span id="operationTargetInfo"></span></span>
            <span class="close" id="closeSelectOperationModal">&times;</span>
        </div>
        <div class="modal-body">
            <div id="operationsContainer" style="max-height: 400px; overflow-y: auto;">
                <div class="build-loading">Loading operations...</div>
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" id="cancelSelectOperationBtn">Cancel</button>
        </div>
    </div>
</div>

{# Operation Mode Banner #}
<div id="operationModeBanner" class="attack-mode-banner" style="display: none;">
    <span id="operationModeText">Select a region to launch operation from...</span>
    <button type="button" id="cancelOperationModeBtn">Cancel</button>
</div>

{# Operation Units Modal #}
<div id="operationUnitsModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <span class="modal-title">Launch Operation — <span id="operationUnitsName"></span></span>
            <span class="close" id="closeOperationUnitsModal">&times;</span>
        </div>
        <div class="modal-body">
            <div id="operationUnitsInfo" style="margin-bottom: 15px; font-size: 13px;"></div>
            <div id="operationUnitsContainer">
                <div class="build-loading">Loading...</div>
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" id="cancelOperationUnitsBtn">Cancel</button>
            <button type="button" id="confirmOperationBtn" style="background: #9c27b0;">Launch Operation</button>
        </div>
    </div>
</div>

{# Operation Results Modal #}
<div id="operationResultsModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <span class="modal-title">Operation Results</span>
            <span class="close" id="closeOperationResultsModal">&times;</span>
        </div>
        <div class="modal-body">
            <div id="operationResultsContainer"></div>
        </div>
        <div class="modal-footer">
            <button type="button" id="closeOperationResultsBtn">Close</button>
        </div>
    </div>
</div>

{# Messages Modal #}
<div id="messagesModal" class="modal">
    <div class="modal-content modal-lg">
        <div class="modal-header">
            <span class="modal-title" id="messagesModalTitle">Messages</span>
            <span class="close" id="closeMessagesModal">&times;</span>
        </div>
        <div class="modal-body">
            <div class="build-tabs" id="messagesTabs"></div>
            <div id="messagesContainer" style="max-height: 400px; overflow-y: auto;">
                <div class="build-loading">Loading messages...</div>
            </div>
        </div>
        <div class="modal-footer" id="messagesFooter">
            <button type="button" id="closeMessagesBtn">Close</button>
        </div>
    </div>
</div>

{# Attack Unit Selection Modal #}
<div id="attackUnitsModal" class="modal">
    <div class="modal-content build-modal-content">
        <div class="modal-header">
            <span class="modal-title">Select Units to Attack — <span id="attackUnitsTarget"></span></span>
            <span class="close" id="closeAttackUnitsModal">&times;</span>
        </div>
        <div class="modal-body">
            <div id="attackUnitsInfo" style="margin-bottom: 15px; font-size: 13px;"></div>
            <div id="attackUnitsContainer" class="build-units-container">
                <div class="build-loading">Loading units...</div>
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" id="cancelAttackUnitsBtn">Cancel</button>
            <button type="button" id="confirmAttackUnitsBtn" style="background: #c44;">⚔ Send Attack</button>
        </div>
    </div>
</div>

{# Send Message Modal #}
<div id="sendMessageModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <span class="modal-title">Send Message to <span id="sendMessageRecipient"></span></span>
            <span class="close" id="closeSendMessageModal">&times;</span>
        </div>
        <div class="modal-body">
            <div class="message-form">
                <div class="message-form-group">
                    <label for="messageSubject">Subject</label>
                    <input type="text" id="messageSubject" maxlength="255" placeholder="Enter subject...">
                </div>
                <div class="message-form-group">
                    <label for="messageBody">Message</label>
                    <textarea id="messageBody" rows="5" placeholder="Type your message..."></textarea>
                </div>
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" id="cancelSendMessageBtn">Cancel</button>
            <button type="button" id="confirmSendMessageBtn">Send Message</button>
        </div>
    </div>
</div>

{# Research Tech Tree Modal #}
<div id="researchModal" class="modal">
    <div class="modal-content modal-xl">
        <div class="modal-header">
            <span class="modal-title">Research Tech Tree</span>
            <span class="close" id="closeResearchModal">&times;</span>
        </div>
        <div class="modal-body">
            <div id="researchTreeContainer" class="research-tree-container">
                <div class="build-loading">Loading research tree...</div>
            </div>
        </div>
    </div>
</div>

{# Send Units Modal - Step 1: Select units #}
<div id="sendUnitsModal" class="modal">
    <div class="modal-content build-modal-content">
        <div class="modal-header">
            <span class="modal-title">Send Units — From <span id="sendUnitsSource"></span></span>
            <span class="close" id="closeSendUnitsModal">&times;</span>
        </div>
        <div class="modal-body">
            <div id="sendUnitsInfo" style="margin-bottom: 15px; font-size: 13px;"></div>
            <div id="sendUnitsContainer" class="build-units-container">
                <div class="build-loading">Loading available units...</div>
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" id="cancelSendUnitsBtn">Cancel</button>
            <button type="button" id="confirmSendUnitsBtn" style="background: #2196F3;">🚀 Select Target</button>
        </div>
    </div>
</div>