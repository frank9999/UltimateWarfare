
{% import "game/macros/map.html.twig" as mapMacros %}
{% extends 'v2/game.html.twig' %}

{% block title %}Ultimate Warfare - World Map{% endblock title %}

{% block javascripts %}
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="{{ asset('js/leaflet-worldmap.js') }}"></script>
{% endblock javascripts %}

{% block content %}
    <style>
        #worldMapContainer {
            position: relative;
            width: 100%;
            height: 100vh;
            background: #2c3e50;
        }

        #worldMap {
            width: 100%;
            height: 100%;
        }

        .leaflet-container {
            background: #34495e;
        }

        .tile-info-popup {
            min-width: 200px;
        }

        .tile-info-popup h4 {
            margin: 0 0 10px 0;
            color: #2c3e50;
        }

        .tile-info-popup .info-row {
            display: flex;
            justify-content: space-between;
            margin: 5px 0;
        }

        .tile-info-popup .info-label {
            font-weight: bold;
            color: #7f8c8d;
        }

        .tile-info-popup .actions {
            margin-top: 15px;
            text-align: center;
        }

        .tile-info-popup .btn {
            margin: 0 5px;
            padding: 5px 15px;
            border: none;
            border-radius: 3px;
            cursor: pointer;
            font-size: 12px;
        }

        .btn-primary {
            background: #3498db;
            color: white;
        }

        .btn-success {
            background: #27ae60;
            color: white;
        }

        .btn-info {
            background: #17a2b8;
            color: white;
        }

        /* Loading spinner */
        .loading-overlay {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.5);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 1000;
        }

        .loading-spinner {
            width: 40px;
            height: 40px;
            border: 4px solid #f3f3f3;
            border-top: 4px solid #3498db;
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
    </style>

    <div id="worldMapContainer">
        <div id="worldMap"></div>
        <div id="loadingOverlay" class="loading-overlay" style="display: none;">
            <div class="loading-spinner"></div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const worldMapManager = new WorldMapManager('worldMap');
            worldMapManager.initialize();
        });
    </script>
{% endblock %}
